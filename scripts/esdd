#!/usr/bin/env python3
"""esdd - Exhaustive Spec-Driven Development toolkit.

Stdlib-only CLI. Wraps Taskwarrior with upward .esdd discovery and UDA
injection, scaffolds MADR ADRs at three levels, and enforces the ESDD
token budget at handoff.

Subcommands:
  init                 scaffold .esdd/ in the current directory
  doctor               check the installation and workspace
  env [K [V]]          read/write .esdd/env (graph nav configuration)
  tw [--batch] -- ARGS run task(1) against the nearest .esdd/tasks
  spec new|list        scaffold a spec workspace (and its index task)
  adr new|list         MADR ADRs at global / directory / spec level
  matrix [--spec S]    blocking-edge matrix from `task export`
  estimate [--spec S]  token estimates from each task's touches UDA
  verify --spec S      handoff gate: index task, ADRs, budgets, cycles
  review --gate GATE   deterministic review gates (design/tickets/code)
  phase [NAME]         phase state tracker with prerequisite checks
"""

import argparse
import glob
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import date
from pathlib import Path

ESDD_DIR = ".esdd"
SOFT_LIMIT = 100_000          # preferred max context per task
HARD_LIMIT = 140_000          # absolute stop; requires human sign-off
PER_FILE_OVERHEAD = 1500      # tokens of tooling/path overhead per touched file
SLUG_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
GRAPH_NAV_CHOICES = ["codegraph", "graphify", "falkordb", "neo4j",
                     "understand", "groma", "custom", "none"]

SCRIPT_DIR = Path(__file__).resolve().parent
ASSETS = SCRIPT_DIR.parent / "assets"

UDA_OVERRIDES = [
    "rc.uda.adrs.type=string",
    "rc.uda.token_estimate.type=numeric",
    "rc.uda.touches.type=string",
    "rc.uda.worker.type=string",
]

PHASES = {
    "product": {"refs": ["references/product.md"], "requires": []},
    "qaw": {"refs": ["references/qaw.md"], "requires": ["specs/{s}/proposal.md"]},
    "tree": {"refs": ["references/utility-tree.md"], "requires": ["specs/{s}/proposal.md"]},
    "add": {
        "refs": ["references/add.md", "references/c4-plantuml.md"],
        "requires": ["specs/{s}/proposal.md", "specs/{s}/utility-tree.md"],
    },
    "atam": {"refs": ["references/atam.md"], "requires": ["specs/{s}/design.md"]},
    "handoff": {
        "refs": ["references/token-budget.md", "references/taskwarrior.md"],
        "requires": ["specs/{s}/design.md"],
    },
    # retro is workspace-level: it takes no spec. It documents an existing
    # repo into ESDD scaffolding (design.md C4, inferred ADRs, catalogue).
    "retro": {"refs": ["references/retro.md"], "requires": [], "spec": False},
}


# ---------------------------------------------------------------- output ---

def out(msg=""):
    print(msg)


def die(msg, code=1):
    print(f"esdd: error: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"esdd: warning: {msg}", file=sys.stderr)


# ----------------------------------------------------------------- paths ---

def find_root(explicit=None):
    """Return the workspace root: the directory that contains .esdd/."""
    if explicit:
        p = Path(explicit).expanduser().resolve()
        if (p / ESDD_DIR).is_dir():
            return p
        die(f"no {ESDD_DIR}/ directory under {p} (run: esdd init)")
    cur = Path.cwd().resolve()
    while True:
        if (cur / ESDD_DIR).is_dir():
            return cur
        if cur.parent == cur:
            die(f"no {ESDD_DIR}/ found in this directory or any parent "
                f"(run: esdd init at your workspace root)")
        cur = cur.parent


def slugify(text):
    return re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", text.lower())).strip("-")


def check_slug(slug, what="slug"):
    if not SLUG_RE.match(slug or ""):
        die(f"invalid {what} '{slug}': lowercase letters, digits and hyphens "
            f"only; no dots (dots are Taskwarrior's project separator)")


def workspace_name(root):
    return slugify(root.name) or "workspace"


def assets_path(name):
    p = ASSETS / name
    return p if p.exists() else None


def render_template(name, mapping, dest):
    src = assets_path(name)
    if not src:
        die(f"missing template {name} (expected at {src})")
    text = src.read_text()
    for k, v in mapping.items():
        text = text.replace(f"<{k}>", str(v))
    Path(dest).write_text(text)
    return Path(dest)


# ------------------------------------------------------------ taskwarrior ---

def task_binary():
    return shutil.which("task")


def task_env(root):
    """Environment for task(1). Taskwarrior refuses to run without an rc
    file; when the user has none, use a workspace one (ESDD settings are
    all passed as rc.* overrides, so it can stay empty)."""
    env = os.environ.copy()
    taskrc = os.environ.get("TASKRC") or Path.home() / ".config" / "task" / "taskrc"
    home = Path.home()
    if (taskrc.exists() or (home / ".taskrc").exists()
            or (home / ".task" / "taskrc").exists()):
        return env
    rc = root / ESDD_DIR / "tasks" / "taskrc"
    if not rc.exists():
        rc.write_text("# created by esdd: Taskwarrior needs an rc file; "
                      "ESDD settings are all passed as rc.* overrides\n")
    env["TASKRC"] = str(rc)
    return env


def run_task(root, args, batch=False, quiet=False):
    """Run task(1) with .esdd data location and ESDD UDAs injected."""
    task = task_binary()
    if not task:
        die("taskwarrior 'task' binary not found on PATH. Install "
            "taskwarrior (https://taskwarrior.org) or proceed with "
            "markdown-only planning and track tasks by hand.")
    cmd = [task, f"rc.data.location={root / ESDD_DIR / 'tasks'}", *UDA_OVERRIDES]
    if batch:
        cmd += ["rc.confirmation=no", "rc.recurrence.confirmation=no"]
    cmd += list(args)
    # quiet keeps task(1)'s chatter off stdout when stdout carries --json
    return subprocess.call(cmd, env=task_env(root),
                           stdout=subprocess.DEVNULL if quiet else None)


def task_json(root, filters=()):
    """`task export` parsed to a list of dicts."""
    task = task_binary()
    if not task:
        die("taskwarrior 'task' binary not found on PATH; cannot query tasks.")
    # note: repeated `status:X` filters AND together in taskwarrior; the
    # parenthesized `or` expression is the correct way to union them
    cmd = [task, f"rc.data.location={root / ESDD_DIR / 'tasks'}",
           *UDA_OVERRIDES,
           "(", "status:pending", "or", "status:waiting", "or",
           "status:in-progress", "or", "status:completed", ")",
           *filters, "export"]
    res = subprocess.run(cmd, capture_output=True, text=True,
                         env=task_env(root))
    if res.returncode != 0:
        die(f"task export failed: {res.stderr.strip()}")
    try:
        return json.loads(res.stdout or "[]")
    except json.JSONDecodeError as e:
        die(f"could not parse task export: {e}")


def spec_tasks(tasks, slug):
    """Tasks whose Taskwarrior project leaf is the spec slug."""
    return [t for t in tasks
            if (t.get("project") or "").split(".")[-1] == slug]


def dep_uuids(task):
    d = task.get("depends") or []
    if isinstance(d, str):
        d = [x for x in d.split(",") if x]
    return d


# -------------------------------------------------------------- estimate ---

def estimate_tokens(root, patterns):
    """chars/4 + per-file overhead. Returns (tokens, files, missing)."""
    files = []
    missing = []
    for pat in patterns:
        pat = pat.strip()
        if not pat:
            continue
        matches = [p for p in glob.glob(str(root / pat), recursive=True)
                   if Path(p).is_file()]
        if matches:
            files.extend(matches)
        else:
            missing.append(pat)
    files = sorted(set(files))
    chars = 0
    for f in files:
        try:
            chars += len(Path(f).read_text(errors="replace"))
        except OSError:
            missing.append(f)
    tokens = chars // 4 + PER_FILE_OVERHEAD * len(files)
    return tokens, files, missing


def verdict_for(tokens):
    if tokens <= SOFT_LIMIT:
        return "ok"
    if tokens <= HARD_LIMIT:
        return "SPLIT"
    return "HARD-STOP"


# -------------------------------------------------------------- env/state ---

def env_path(root):
    return root / ESDD_DIR / "env"


def read_env(root):
    env = {}
    p = env_path(root)
    if p.exists():
        for line in p.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env[k.strip()] = v.strip()
    return env


def write_env(root, env):
    lines = [f"{k}={v}" for k, v in sorted(env.items())]
    env_path(root).write_text("\n".join(lines) + "\n")


def state_path(root):
    return root / ESDD_DIR / "state.json"


def read_state(root):
    p = state_path(root)
    if p.exists():
        try:
            return json.loads(p.read_text())
        except json.JSONDecodeError:
            warn("state.json is corrupt; starting fresh")
    return {"current_phase": None, "completed": [], "spec": None}


def write_state(root, state):
    state_path(root).write_text(json.dumps(state, indent=2) + "\n")


# ------------------------------------------------------------------- init ---

def cmd_init(a):
    root = Path.cwd().resolve()
    esdd = root / ESDD_DIR
    for d in ("adrs", "tasks", "specs", "graph"):
        (esdd / d).mkdir(parents=True, exist_ok=True)

    nav = a.graph_nav or "unconfigured"
    if not env_path(root).exists():
        write_env(root, {"GRAPH_NAV": nav})

    if not state_path(root).exists():
        write_state(root, {"current_phase": None, "completed": [], "spec": None})

    shared = esdd / "design.md"
    if not shared.exists() and assets_path("design-shared-template.md"):
        render_template("design-shared-template.md",
                        {"WORKSPACE": workspace_name(root), "DATE": date.today()},
                        shared)

    out(f"initialised {esdd}/")
    out("")
    out("  .esdd/")
    out("  ├── adrs/        directory-level MADR ADRs (team conventions)")
    out("  ├── tasks/       Taskwarrior data location")
    out("  ├── specs/       one directory per feature spec")
    out("  ├── graph/       cached graph/nav snapshots (esdd import)")
    out("  ├── design.md    shared C4 System Context + Container views")
    out("  ├── env          configuration (GRAPH_NAV)")
    out("  └── state.json   phase tracker")
    out("")
    if nav == "unconfigured":
        out("NEXT - ask the human (Phase 0 graph-navigation question):")
        out('  "Which code-navigation aid should ESDD use? '
            'codegraph | graphify | falkordb | neo4j | custom | none"')
        out("Then: esdd env set GRAPH_NAV <choice>")
    else:
        out(f"GRAPH_NAV={nav}")
    out("")
    out("Global ADRs (Level 1) live at ~/.esdd/adrs and apply to every "
        "workspace; create them with: esdd adr new --level global")


# ----------------------------------------------------------------- doctor ---

def cmd_doctor(a):
    root = find_root(a.root)
    out(f"workspace root: {root} (.esdd found)")
    task = task_binary()
    if task:
        ver = subprocess.run([task, "--version"], capture_output=True,
                             text=True).stdout.strip().splitlines()
        out(f"taskwarrior:     {ver[0] if ver else task}")
    else:
        out("taskwarrior:     NOT FOUND (markdown-only mode)")
    data = root / ESDD_DIR / "tasks"
    out(f"data location:   {data} "
        f"({'writable' if os.access(data, os.W_OK) else 'NOT WRITABLE'})")
    env = read_env(root)
    out(f"GRAPH_NAV:       {env.get('GRAPH_NAV', 'unset')}")
    gbase = graph_root(root)
    sources = sorted(d.name for d in gbase.iterdir() if d.is_dir()) \
        if gbase.is_dir() else []
    out(f"graph sources:   {', '.join(sources) or 'none cached'}")
    state = read_state(root)
    out(f"phase:           {state.get('current_phase') or '-'} "
        f"(completed: {', '.join(state.get('completed', [])) or '-'})")
    g = Path.home() / ESDD_DIR / "adrs"
    out(f"global ADRs:     {g} ({len(list(g.glob('*.md'))) if g.is_dir() else 0} files)")


# -------------------------------------------------------------------- env ---

def cmd_env(a):
    root = find_root(a.root)
    env = read_env(root)
    if a.key == "set":
        # documented form: esdd env set KEY VALUE
        if a.value is None or a.extra is None:
            die("usage: esdd env set KEY VALUE")
        a.key, a.value = a.value, a.extra
    elif a.extra is not None:
        die(f"unrecognized arguments: {a.extra}")
    if a.unset:
        env.pop(a.unset, None)
        write_env(root, env)
        out(f"unset {a.unset}")
        return
    if a.value is None and a.key is None:
        for k, v in sorted(env.items()):
            out(f"{k}={v}")
        return
    if a.value is None:
        if a.key not in env:
            die(f"key '{a.key}' not set")
        out(f"{a.key}={env[a.key]}")
        return
    if a.key == "GRAPH_NAV" and a.value not in GRAPH_NAV_CHOICES + ["unconfigured"]:
        die(f"GRAPH_NAV must be one of: {', '.join(GRAPH_NAV_CHOICES)}")
    env[a.key] = a.value
    write_env(root, env)
    out(f"{a.key}={a.value}")


# ---------------------------------------------------------------------- tw ---

def cmd_tw(a):
    root = find_root(a.root)
    args = list(a.args)
    if args and args[0] == "--":
        args = args[1:]
    if not args:
        die("pass task arguments after '--', e.g.: esdd tw -- next")
    sys.exit(run_task(root, args, batch=a.batch))


# --------------------------------------------------------------------- spec ---

def scaffold_spec(root, slug, project, title):
    """Create .esdd/specs/<slug>/ (dirs + rendered templates). Idempotent:
    existing files are left untouched. Returns the template mapping."""
    check_slug(slug)
    sdir = root / ESDD_DIR / "specs" / slug
    (sdir / "diagrams").mkdir(parents=True, exist_ok=True)
    (sdir / "adrs").mkdir(exist_ok=True)
    (sdir / "sources").mkdir(exist_ok=True)
    mapping = {"SLUG": slug, "TITLE": title or slug.replace("-", " ").title(),
               "DATE": date.today(), "PROJECT": project,
               "WORKSPACE": workspace_name(root),
               "FULL_PROJECT": f"{workspace_name(root)}.{project}.{slug}"}
    for tpl, name in [("proposal-template.md", "proposal.md"),
                      ("design-template.md", "design.md"),
                      ("utility-tree-template.md", "utility-tree.md")]:
        dest = sdir / name
        if not dest.exists() and assets_path(tpl):
            render_template(tpl, mapping, dest)
    return mapping, sdir


def cmd_spec_new(a):
    root = find_root(a.root)
    check_slug(a.slug)
    sdir = root / ESDD_DIR / "specs" / a.slug
    if sdir.exists() and any(sdir.iterdir()) and not a.force:
        die(f"spec '{a.slug}' already exists at {sdir} (use --force to rescaffold)")
    mapping, sdir = scaffold_spec(root, a.slug, a.project, a.title)

    out(f"spec '{a.slug}' scaffolded at {sdir}/")
    out(f"Taskwarrior project: {mapping['FULL_PROJECT']}")

    if not a.no_index:
        proj = mapping["FULL_PROJECT"]
        if task_binary():
            run_task(root, ["add", f"{a.slug} :: spec index",
                            f"project:{proj}", "+spec", 'adrs:""'], batch=True)
            created = task_json(root, [f"project:{proj}", "+spec"])
            if created:
                newest = max(created, key=lambda t: t.get("entry_ts", ""))
                run_task(root, [newest["uuid"], "annotate",
                                f"Spec dir: {ESDD_DIR}/specs/{a.slug}/ - "
                                "proposal.md, design.md, utility-tree.md. "
                                "Keep the adrs UDA in sync with adrs/*.md."],
                         batch=True)
                out(f"index task created: {newest.get('id')} (uuid {newest['uuid'][:8]}...)")
        else:
            out("taskwarrior not found - create the index task later with:")
            out(f"  esdd tw -- add '{a.slug} :: spec index' "
                f"project:{proj} +spec 'adrs:\"\"'")
    out("")
    out("Next: esdd phase product --spec " + a.slug)


def cmd_po_import(a):
    """Copy an external spec/plan into .esdd/specs/<slug>/sources/ and prep
    PO import mode (the Lite/existing-spec entry path)."""
    root = find_root(a.root)
    if not a.spec:
        die("--spec is required (esdd po import <file> --spec <slug>)")
    check_slug(a.spec)
    src = Path(a.file).expanduser().resolve()
    if not src.is_file():
        die(f"source file not found: {src}")
    existed = (root / ESDD_DIR / "specs" / a.spec / "proposal.md").is_file()
    mapping, sdir = scaffold_spec(root, a.spec, a.project, a.title)
    sources = sdir / "sources"
    dest = sources / src.name
    shutil.copy2(src, dest)
    out(f"copied '{src.name}' into {sources}")
    out(f"spec '{a.spec}': proposal.md "
        f"{'exists - PO extends it' if existed else 'scaffolded'}")
    out("next: dispatch esdd-po in import mode for spec '" + a.spec + "'")
    out("it maps the source into proposal.md, converts acceptance criteria")
    out("into GWT (each conversion marked `converted` and confirmed by the")
    out("human), and grills only the gaps. Then run the Architect — or the")
    out("lite path (skip Phases 2-5) if the plan is already decided.")


def cmd_spec_list(a):
    root = find_root(a.root)
    specs_dir = root / ESDD_DIR / "specs"
    if not specs_dir.is_dir():
        die(f"no specs directory at {specs_dir}")
    rows = []
    for d in sorted(specs_dir.iterdir()):
        if not d.is_dir():
            continue
        marks = []
        for f, label in [("proposal.md", "P"), ("utility-tree.md", "U"),
                         ("design.md", "D")]:
            p = d / f
            marks.append(label if p.exists() and len(p.read_text()) > 200 else "-")
        rows.append((d.name, "".join(marks), len(list((d / "adrs").glob("*.md")))))
    if a.json:
        out(json.dumps([{"spec": n, "proposal": m[0] == "P",
                         "utility_tree": m[1] == "U",
                         "design": m[2] == "D", "spec_adrs": k}
                        for n, m, k in rows]))
        return
    if not rows:
        out("no specs yet - create one with: esdd spec new <slug> --project <proj>")
        return
    out("| spec | P=proposal U=utility-tree D=design | spec ADRs |")
    out("|------|------------------------------------|-----------|")
    for name, marks, nadrs in rows:
        out(f"| {name} | {marks} | {nadrs} |")


# ---------------------------------------------------------------------- adr ---

def adr_dirs(root, spec=None):
    dirs = {"global": Path.home() / ESDD_DIR / "adrs",
            "directory": root / ESDD_DIR / "adrs",
            "spec": root / ESDD_DIR / "specs" / spec / "adrs" if spec else None}
    return dirs


def next_adr_number(adir):
    nums = [int(m.group(1)) for f in adir.glob("*.md")
            if (m := re.match(r"(\d{4})-", f.name))]
    return max(nums, default=0) + 1


def cmd_adr_new(a):
    check_slug(slugify(a.title), "title slug")
    if a.level == "spec":
        if not a.spec:
            die("--spec is required for --level spec")
        check_slug(a.spec)
    root = find_root(a.root)
    adir = adr_dirs(root, a.spec)[a.level]
    adir.mkdir(parents=True, exist_ok=True)
    n = next_adr_number(adir)
    slug = slugify(a.title)
    path = adir / f"{n:04d}-{slug}.md"
    render_template("adr-template.md",
                    {"NNNN": f"{n:04d}", "TITLE": a.title, "DATE": date.today()},
                    path)
    out(f"created {a.level} ADR: {path}")
    if a.level == "spec":
        out("remember to add the entry to the spec index task:")
        out(f'  esdd tw -- <index-task-uuid> modify adrs:"<existing>,{n:04d}-{slug}"')


def cmd_adr_list(a):
    root = find_root(a.root)
    levels = [a.level] if a.level else ["spec", "directory", "global"]
    shown = False
    for level in levels:
        if level == "spec":
            if a.spec:
                spec_dirs = [root / ESDD_DIR / "specs" / a.spec]
            else:
                specs = root / ESDD_DIR / "specs"
                spec_dirs = sorted(d for d in specs.iterdir() if d.is_dir()) \
                    if specs.is_dir() else []
            for sd in spec_dirs:
                adir = sd / "adrs"
                if not adir.is_dir() or not any(adir.glob("*.md")):
                    continue
                shown = True
                out(f"[spec:{sd.name}] {adir}")
                for line in adr_file_lines(adir):
                    out(f"  {line}")
                out("")
            continue
        adir = adr_dirs(root)[level]
        if not adir or not adir.is_dir() or not any(adir.glob("*.md")):
            continue
        shown = True
        out(f"[{level}] {adir}")
        for line in adr_file_lines(adir):
            out(f"  {line}")
        out("")
    if not shown:
        out("no ADRs found at any level")


def adr_records(adir):
    """Parse MADR files into {file, stem, title, status} (status '?' if absent)."""
    rows = []
    for f in sorted(adir.glob("*.md")):
        text = f.read_text(errors="replace")
        tm = re.search(r"^#\s+\d+\.\s+(.+)$", text, re.M)
        sm = re.search(r"^##\s*Status\s*\n\s*(\S+)", text, re.M)
        rows.append({"file": f, "stem": f.stem,
                     "title": tm.group(1).strip() if tm else f.stem,
                     "status": sm.group(1).strip() if sm else "?"})
    return rows


def adr_file_lines(adir):
    return [f"{r['stem']}  [{r['status']}]  {r['title']}"
            for r in adr_records(adir)] or ["(none)"]


# ------------------------------------------------------------------- matrix ---

def build_graph(tasks):
    by_uuid = {t["uuid"]: t for t in tasks if t.get("uuid")}
    deps = {u: [d for d in dep_uuids(t) if d in by_uuid]
            for u, t in by_uuid.items()}
    return by_uuid, deps


def find_cycles(deps):
    color, stack, cycles = {}, [], []

    def dfs(u):
        color[u] = 1
        stack.append(u)
        for v in deps.get(u, []):
            if color.get(v, 0) == 1:
                cycles.append(stack[stack.index(v):] + [v])
            elif color.get(v, 0) == 0:
                dfs(v)
        stack.pop()
        color[u] = 2

    for u in list(deps):
        if color.get(u, 0) == 0:
            dfs(u)
    return cycles


def cmd_matrix(a):
    root = find_root(a.root)
    tasks = task_json(root)
    if a.spec:
        tasks = spec_tasks(tasks, a.spec)
    if not tasks:
        out(json.dumps({"tasks": [], "cycles": []}) if a.json
            else "no tasks found.")
        return
    by_uuid, deps = build_graph(tasks)
    blocks = {u: [] for u in by_uuid}
    for u, ds in deps.items():
        for d in ds:
            blocks[d].append(u)
    tids = {u: str(t.get("id", "?")) for u, t in by_uuid.items()}

    def label(u):
        desc = (by_uuid[u].get("description") or "")[:48]
        return f"{tids[u]}:{desc}"

    lines = []
    lines.append(f"| Task | Project | Depends on (blocked by) | Blocks |")
    lines.append("|------|---------|--------------------------|--------|")
    for t in sorted(tasks, key=lambda x: (x.get("project") or "", x.get("id") or 0)):
        u = t.get("uuid")
        dep = ", ".join(tids.get(d, d[:8]) for d in deps.get(u, [])) or "-"
        blk = ", ".join(tids.get(b, b[:8]) for b in blocks.get(u, [])) or "-"
        lines.append(f"| {tids[u]}: {(t.get('description') or '')[:48]} "
                     f"| {t.get('project') or '-'} | {dep} | {blk} |")
    cycles = find_cycles(deps)
    for cyc in cycles:
        lines.append("")
        lines.append(f"WARNING dependency cycle: "
                     f"{' -> '.join(tids.get(u, u[:8]) for u in cyc)}")
    text = "\n".join(lines) + "\n"
    if a.json:
        if a.out:
            Path(a.out).write_text(text)
        out(json.dumps({"tasks": [{"id": t.get("id"), "uuid": t.get("uuid"),
                                   "description": t.get("description"),
                                   "project": t.get("project"),
                                   "depends": deps.get(t.get("uuid"), []),
                                   "blocks": blocks.get(t.get("uuid"), [])}
                                  for t in tasks],
                         "cycles": cycles}))
        return
    if a.out:
        Path(a.out).write_text(text)
        out(f"matrix written to {a.out} ({len(tasks)} tasks, {len(cycles)} cycles)")
    else:
        out(text)


# ----------------------------------------------------------------- estimate ---

def cmd_estimate(a):
    root = find_root(a.root)
    if a.touches is not None:
        # Taskwarrior-free estimate, used by the tasks.md fallback
        tokens, files, missing = estimate_tokens(root, a.touches.split(","))
        v = verdict_for(tokens)
        if a.json:
            out(json.dumps({"tokens": tokens, "files": len(files),
                            "missing": missing, "verdict": v}))
        else:
            out(f"{tokens} tokens over {len(files)} files: {v}"
                + (f" (missing globs: {', '.join(missing)})" if missing else ""))
        return
    tasks = task_json(root)
    if a.spec:
        tasks = spec_tasks(tasks, a.spec)
    if not a.all:
        tasks = [t for t in tasks if t.get("touches")]
    if not tasks:
        out(json.dumps({"tasks": []}) if a.json
            else "no tasks with a touches UDA found.")
        return
    rows = []
    for t in sorted(tasks, key=lambda x: x.get("id") or 0):
        patterns = (t.get("touches") or "").split(",")
        tokens, files, missing = estimate_tokens(root, patterns)
        v = verdict_for(tokens)
        rows.append((t, tokens, len(files), missing, v))
        if a.set and t.get("uuid"):
            run_task(root, [t["uuid"], "modify", f"token_estimate:{tokens}"],
                     batch=True, quiet=a.json)
    if a.json:
        out(json.dumps([{"id": t.get("id"), "uuid": t.get("uuid"),
                         "description": t.get("description"), "files": nf,
                         "tokens": tokens, "verdict": v, "missing": missing}
                        for t, tokens, nf, missing, v in rows]))
        return
    out("| Task | Files | Est. tokens | Verdict | Missing globs |")
    out("|------|-------|-------------|---------|---------------|")
    for t, tokens, nf, missing, v in rows:
        flag = "" if v == "ok" else "  <<<"
        out(f"| {t.get('id')}: {(t.get('description') or '')[:44]} "
            f"| {nf} | {tokens:,} | {v}{flag} | {', '.join(missing) or '-'} |")
    out("")
    out(f"budget: ok <= {SOFT_LIMIT:,} | SPLIT <= {HARD_LIMIT:,} | "
        f"above = HARD-STOP (needs human sign-off)")
    if a.set:
        out("token_estimate UDA written back to tasks.")


# ------------------------------------------------------------------ verify ---

def compute_verify(root, slug):
    """Deterministic handoff gate. Returns a result dict; never prints/exits."""
    sdir = root / ESDD_DIR / "specs" / slug
    if not sdir.is_dir():
        return {"spec": slug, "sdir": sdir, "pass": False,
                "failures": [f"no spec directory at {sdir}"],
                "notes": [], "human_work_order": [], "tasks": []}
    tasks = spec_tasks(task_json(root), slug)
    failures, notes = [], []

    index = [t for t in tasks if "spec" in (t.get("tags") or [])]
    index_uuids = {t["uuid"] for t in index}
    if len(index) != 1:
        failures.append(f"expected exactly 1 index task (+spec), found {len(index)}")
        index = index[:1]
    else:
        adr_files = {f.stem for f in (sdir / "adrs").glob("*.md")}
        entries = {e.strip() for e in (index[0].get("adrs") or "").split(",") if e.strip()}
        missing_files = sorted(entries - adr_files)
        unlisted = sorted(adr_files - entries)
        if missing_files:
            failures.append(f"index task adrs UDA lists files that do not exist: "
                            f"{', '.join(missing_files)}")
        if unlisted:
            notes.append(f"ADR files not listed in index task adrs UDA: "
                         f"{', '.join(unlisted)}")

    by_uuid = {t["uuid"]: t for t in tasks if t.get("uuid")}
    dangling = [(t, d) for t in tasks for d in dep_uuids(t)
                if d not in by_uuid]
    for t, d in dangling:
        failures.append(f"task {t.get('id')} depends on unknown uuid {d[:8]}")

    _, deps = build_graph(tasks)
    for cyc in find_cycles(deps):
        failures.append("dependency cycle: " +
                        " -> ".join(str(by_uuid[u].get("id", "?")) for u in cyc))

    for t in tasks:
        if t.get("uuid") in index_uuids:
            continue
        tid = t.get("id")
        est = t.get("token_estimate")
        if not est and t.get("touches"):
            est, _, _ = estimate_tokens(root, (t.get("touches") or "").split(","))
            notes.append(f"task {tid} has touches but no persisted token_estimate "
                         f"(computed {est:,}; run esdd estimate --set)")
        if not est:
            failures.append(f"task {tid} '{(t.get('description') or '')[:40]}' "
                            f"has neither token_estimate nor touches")
        elif est > HARD_LIMIT and not any(
                "HARDCAP-APPROVED" in (x.get("description") or "")
                for x in (t.get("annotations") or [])):
            failures.append(f"task {tid} estimate {est:,} exceeds hard limit "
                            f"{HARD_LIMIT:,} without HARDCAP-APPROVED sign-off")
        if not t.get("worker"):
            notes.append(f"task {tid} has no worker UDA (defaults to agent)")

    human = [t for t in tasks
             if t.get("worker") == "human" and t.get("status") in ("pending", "waiting")]
    return {"spec": slug, "sdir": sdir, "pass": not failures,
            "failures": failures, "notes": notes,
            "human_work_order": [{"id": t.get("id"), "uuid": t.get("uuid"),
                                  "description": t.get("description")}
                                 for t in human],
            "human_tasks": human, "tasks": tasks}


def cmd_verify(a):
    root = find_root(a.root)
    check_slug(a.spec)
    res = compute_verify(root, a.spec)
    if not res["sdir"].is_dir():
        die(f"no spec directory at {res['sdir']}")
    failures, notes = res["failures"], res["notes"]
    human = res["human_tasks"]
    if a.json:
        out(json.dumps({"spec": a.spec, "pass": not failures,
                        "failures": failures, "notes": notes,
                        "human_work_order": res["human_work_order"]}))
        sys.exit(1 if failures else 0)
    out(f"verify spec '{a.spec}':")
    for n in notes:
        out(f"  note:  {n}")
    if not failures:
        out("  PASS - handoff gate clear")
    for f in failures:
        out(f"  FAIL:  {f}")

    if human:
        out("")
        out("human work order:")
        for t in human:
            brief = ""
            if t.get("annotations"):
                brief = " ".join(t["annotations"][0].get("description", "").split())[:100]
            out(f"  [{t.get('id')}] {t.get('description')}")
            if brief:
                out(f"        {brief}")
    sys.exit(1 if failures else 0)


# ------------------------------------------------------------------ review ---

REVIEW_GATES = ["design", "tickets", "code"]
QAS_PARTS = ["Source", "Stimulus", "Artifact", "Environment", "Response",
             "Response Measure"]


def read_text(path):
    try:
        return Path(path).read_text(errors="replace")
    except OSError:
        return None


def md_section(text, heading):
    """Body of a level-2 markdown section (None when absent)."""
    m = re.search(rf"^{re.escape(heading)}\s*$", text or "", re.M)
    if not m:
        return None
    start = m.end()
    nxt = re.search(r"^##\s+", text[start:], re.M)
    return text[start:start + nxt.start()] if nxt else text[start:]


def story_gwt_map(text):
    """US-id -> whether its section contains a ```gherkin block."""
    stories, cur = {}, None
    for line in (text or "").splitlines():
        if line.lstrip().startswith("|"):
            continue
        m = re.match(r"^\s*(?:#{1,6}\s*)?(?:\*\*)?(US-\d+)(?:\*\*)?\s*:?", line)
        if m:
            cur = m.group(1)
            stories.setdefault(cur, False)
            continue
        if line.startswith("## "):
            cur = None
            continue
        if cur and re.match(r"^\s*```gherkin\b", line, re.I):
            stories[cur] = True
    return stories


def impact_map_rows(text):
    sec = md_section(text, "## Impact Map")
    if sec is None:
        return None
    rows = []
    for line in sec.splitlines():
        line = line.strip()
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if cells and cells[0].lower().startswith("goal"):
            continue
        if cells and all(re.fullmatch(r":?-{2,}:?", c) for c in cells if c):
            continue
        if any(cells):
            rows.append(cells)
    return rows


def qas_sections(text):
    return re.split(r"^###\s+QAS-", text or "", flags=re.M)[1:]


def qas_missing_parts(sec):
    missing = []
    for part in QAS_PARTS:
        m = re.search(rf"^\s*(?:-\s*)?\*\*{re.escape(part)}\*\*:\s*(.*)$",
                      sec, re.M | re.I)
        if not m or not m.group(1).strip():
            missing.append(part)
    return missing


def design_interfaces(text):
    """Interface names under '## Interfaces'; None when the section is absent."""
    sec = md_section(text, "## Interfaces")
    if sec is None:
        return None
    names = []
    for line in sec.splitlines():
        m = re.match(r"^###\s+`([^`]+)`\s*$", line)
        if not m:
            m = re.match(r"^###\s+(.+?)\s*$", line)
        if m:
            names.append(m.group(1).strip())
    return names


def diagram_refs(text):
    return sorted(set(re.findall(r"diagrams/[A-Za-z0-9._<>/-]+\.puml",
                                 text or "")))


def first_annotation(task):
    anns = task.get("annotations") or []
    return (anns[0].get("description") or "") if anns else ""


def brief_field(brief, field):
    """Field value in a multi-line brief or a ` | `-separated one-liner."""
    m = re.search(rf"{re.escape(field)}:\s*(.+?)(?=\s+\|\s+|\n|$)",
                  brief or "", re.M | re.I | re.S)
    return m.group(1).strip() if m else None


def brief_interfaces(brief):
    val = brief_field(brief, "Interface obligations")
    if not val or val.lower() in ("none", "-", "n/a", "[]"):
        return []
    names = re.findall(r"`([^`]+)`", val)
    if not names:
        names = [x.strip() for x in re.split(r"[,;]", val) if x.strip()]
    return names


def check_row(checks, rule, fails=(), pass_detail="ok", judgment=None,
              skip=None):
    if skip is not None:
        checks.append({"rule": rule, "status": "skip", "detail": skip})
    elif judgment is not None:
        checks.append({"rule": rule, "status": "judgment", "detail": judgment})
    elif fails:
        checks.append({"rule": rule, "status": "fail",
                       "detail": "; ".join(fails)})
    else:
        checks.append({"rule": rule, "status": "pass", "detail": pass_detail})


def task_label(t):
    return f"task {t.get('id')} '{(t.get('description') or '')[:36]}'"


def task_path(t):
    return f"task:{(t.get('uuid') or '?')[:8]}"


def add_violation(violations, rule, path, detail):
    violations.append({"rule": rule, "path": path or "", "detail": detail})


def actionable_tasks(tasks):
    return [t for t in tasks
            if "spec" not in (t.get("tags") or [])
            and t.get("status") in ("pending", "waiting", "in-progress",
                                    "recurring")]


def task_tokens(root, t):
    est = t.get("token_estimate")
    if est:
        return int(est)
    if t.get("touches"):
        tokens, _, _ = estimate_tokens(root, (t.get("touches") or "").split(","))
        return tokens
    return None


def review_tickets(root, slug, sdir):
    """Deterministic subset of the tickets gate + judgment rows."""
    checks, violations = [], []
    res = compute_verify(root, slug)
    for f in res["failures"]:
        m = re.search(r"task (\d+)", f)
        add_violation(violations, "verify",
                      f"task:{m.group(1)}" if m else "", f)
    check_row(checks, "verify", res["failures"], "verify gate clear")

    tasks = actionable_tasks(res["tasks"])
    proposal = read_text(sdir / "proposal.md") or ""
    stories = story_gwt_map(proposal)
    design = read_text(sdir / "design.md")
    interfaces = design_interfaces(design) if design is not None else None

    missing_brief, no_story, bad_story = [], [], []
    no_verify, no_done, bad_iface, bad_tokens, no_worker = [], [], [], [], []
    for t in tasks:
        brief = first_annotation(t)
        if not brief:
            missing_brief.append((t, "first annotation is not a brief"))
            continue
        sid_m = re.search(r"\b(US-\d+)\b", brief)
        if not sid_m:
            no_story.append((t, "brief names no US-n"))
        else:
            sid = sid_m.group(1)
            if sid not in stories:
                bad_story.append((t, f"{sid} is not in proposal.md"))
            elif not stories[sid]:
                bad_story.append((t, f"{sid} has no GWT block"))
        if "Verify:" not in brief:
            no_verify.append((t, "brief has no Verify:"))
        if "Done when:" not in brief:
            no_done.append((t, "brief has no Done when:"))
        wanted = brief_interfaces(brief)
        if wanted:
            known = set(interfaces or [])
            unknown = [n for n in wanted if n not in known]
            if unknown:
                bad_iface.append(
                    (t, "interfaces not in design.md: " + ", ".join(unknown)))
        est = task_tokens(root, t)
        if est is None:
            bad_tokens.append((t, "no token estimate"))
        elif est > HARD_LIMIT:
            approved = any("HARDCAP-APPROVED" in (ann.get("description") or "")
                           for ann in (t.get("annotations") or []))
            if not approved:
                bad_tokens.append(
                    (t, f"{est:,} over hard limit without HARDCAP-APPROVED"))
        elif est > SOFT_LIMIT:
            bad_tokens.append((t, f"{est:,} in SPLIT band; split required"))
        if not t.get("worker"):
            no_worker.append((t, "worker UDA not set"))

    for rule, items in [
        ("brief-present", missing_brief),
        ("brief-story", no_story),
        ("story-gwt", bad_story),
        ("brief-verify", no_verify),
        ("brief-done-when", no_done),
        ("brief-interfaces", bad_iface),
        ("token-budget", bad_tokens),
        ("worker-set", no_worker),
    ]:
        check_row(checks, rule, [f"{task_label(t)}: {d}" for t, d in items])
        for t, d in items:
            add_violation(violations, rule, task_path(t), d)

    check_row(checks, "gwt-derivation",
              judgment="Verify/Done when must derive from the story's Then "
                       "(agent/human judgement)")
    check_row(checks, "invest",
              judgment="Independent/Small/Testable per references/invest.md "
                       "(agent/human judgement)")
    return checks, violations


def review_design(root, slug, sdir):
    """Mechanical design checks; judgement-shaped items never fail."""
    checks, violations = [], []
    proposal = read_text(sdir / "proposal.md")
    if proposal is None:
        add_violation(violations, "proposal-present", "proposal.md",
                      "proposal.md is missing")
        check_row(checks, "proposal-present", ["proposal.md is missing"])
    else:
        check_row(checks, "proposal-present", pass_detail="proposal.md present")
        rows = impact_map_rows(proposal)
        if rows is None:
            add_violation(violations, "impact-map", "proposal.md",
                          "## Impact Map section is missing")
            check_row(checks, "impact-map", ["## Impact Map section is missing"])
        elif not rows:
            check_row(checks, "impact-map",
                      judgment="Impact Map present but no filled rows")
        else:
            check_row(checks, "impact-map",
                      pass_detail=f"{len(rows)} row(s)")

    tree = read_text(sdir / "utility-tree.md")
    if tree is None:
        add_violation(violations, "utility-tree", "utility-tree.md",
                      "utility-tree.md is missing (lite profile: skip this gate)")
        check_row(checks, "utility-tree", ["utility-tree.md is missing"])
    else:
        secs = qas_sections(tree)
        if not secs:
            check_row(checks, "qas-six-part", judgment="no QAS sections yet")
        else:
            fails = []
            for i, sec in enumerate(secs, 1):
                miss = qas_missing_parts(sec)
                if miss:
                    fails.append(f"QAS-{i} missing: {', '.join(miss)}")
            check_row(checks, "qas-six-part", fails)
            for f in fails:
                add_violation(violations, "qas-six-part", "utility-tree.md", f)

    adir = sdir / "adrs"
    records = adr_records(adir) if adir.is_dir() else []
    if not records:
        check_row(checks, "adr-status", skip="no spec ADRs")
    else:
        fails = [f"{r['stem']}: missing ## Status" for r in records
                 if r["status"] == "?"]
        check_row(checks, "adr-status", fails)
        for f in fails:
            add_violation(violations, "adr-status", "adrs/", f)

    design = read_text(sdir / "design.md")
    if design is None:
        add_violation(violations, "interfaces", "design.md",
                      "design.md is missing")
        check_row(checks, "interfaces", ["design.md is missing"])
    else:
        names = design_interfaces(design)
        if names is None:
            add_violation(violations, "interfaces", "design.md",
                          "## Interfaces section is missing")
            check_row(checks, "interfaces",
                      ["## Interfaces section is missing"])
        elif not names:
            check_row(checks, "interfaces",
                      judgment="Interfaces section has no entries")
        elif any((not n) or "<" in n or ">" in n for n in names):
            check_row(checks, "interfaces",
                      judgment="Interfaces still template placeholders")
        else:
            check_row(checks, "interfaces",
                      pass_detail=f"{len(names)} interface(s)")

        refs = [r for r in diagram_refs(design) if "<" not in r and ">" not in r]
        if not refs:
            check_row(checks, "diagram-refs", skip="no concrete diagram references")
        else:
            missing = [r for r in refs if not (sdir / r).is_file()]
            check_row(checks, "diagram-refs", missing)
            for r in missing:
                add_violation(violations, "diagram-refs", r,
                              "referenced diagram does not exist")

    check_row(checks, "qas-measure",
              judgment="Response Measure must be numeric (agent/human)")
    check_row(checks, "design-trace",
              judgment="Every Impact Map row / ASR must trace to a QAS and "
                       "design.md concept (agent/human)")
    check_row(checks, "adr-supersede",
              judgment="Contradicted accepted ADRs must be superseded and the "
                       "old one marked deprecated (agent/human)")
    check_row(checks, "c4-names",
              judgment="C4 element names in diagrams/*.puml must match "
                       "design.md (agent/human)")
    check_row(checks, "atam-citations",
              judgment="Every ATAM risk must cite a causing ADR or be an "
                       "unmade decision (agent/human)")
    return checks, violations


def brief_verify_command(brief):
    return brief_field(brief, "Verify")


def review_code(root, slug, sdir, task_key, run_verify):
    """Minimal mechanical code gate; returns (checks, violations, patterns)."""
    checks, violations = [], []
    tasks = spec_tasks(task_json(root), slug)
    matches = [t for t in tasks if (t.get("uuid") or "").startswith(task_key)]
    if len(matches) != 1:
        return None, None, None, (f"task '{task_key}' not found or ambiguous "
                                  f"in spec '{slug}'")
    t = matches[0]
    brief = first_annotation(t)

    def emit(rule, fails):
        check_row(checks, rule, fails)
        for f in fails:
            add_violation(violations, rule, task_path(t), f)

    if not brief:
        emit("brief-present", ["first annotation is not a brief"])
    else:
        check_row(checks, "brief-present", pass_detail="brief present")
        emit("brief-verify", [] if "Verify:" in brief
             else ["brief has no Verify:"])
        emit("brief-done-when", [] if "Done when:" in brief
             else ["brief has no Done when:"])

    patterns = [p.strip() for p in (t.get("touches") or "").split(",")
                if p.strip()]
    if not patterns:
        emit("touches-resolve", ["task has no touches UDA"])
    else:
        _, files, missing = estimate_tokens(root, patterns)
        fails = []
        if missing:
            fails.append("globs match nothing: " + ", ".join(missing))
        elif not files:
            fails.append("touches resolve to no files")
        emit("touches-resolve", fails)

    if not run_verify:
        check_row(checks, "verify-run", skip="not run (pass --run-verify)")
    else:
        cmd = brief_verify_command(brief)
        if not cmd:
            emit("verify-run", ["no Verify: command in brief"])
        else:
            try:
                r = subprocess.run(cmd, shell=True, cwd=str(root),
                                   capture_output=True, text=True, timeout=600)
                ok = r.returncode == 0
                tail = " ".join((r.stdout + r.stderr).strip().splitlines()[-1:])[:200]
                detail = f"`{cmd}` -> exit {r.returncode}"
                if tail:
                    detail += f": {tail}"
            except (OSError, subprocess.TimeoutExpired) as e:
                ok, detail = False, f"`{cmd}` failed to run: {e}"
            if ok:
                check_row(checks, "verify-run", pass_detail=detail)
            else:
                emit("verify-run", [detail])

    check_row(checks, "gwt-then",
              judgment="The brief's story Then must be observably met "
                       "(agent/human)")
    check_row(checks, "interface-contracts",
              judgment="design.md interface contracts must be honoured "
                       "(agent/human)")
    check_row(checks, "diff-within-touches",
              judgment="Diff must stay within the touches globs (agent/human)")
    return checks, violations, patterns, None


def git_head(root):
    try:
        r = subprocess.run(["git", "-C", str(root), "rev-parse", "HEAD"],
                           capture_output=True, text=True)
    except OSError:
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def git_changed_since(root, rev, patterns=()):
    cmd = ["git", "-C", str(root), "diff", "--name-only", f"{rev}..HEAD"]
    if patterns:
        cmd += ["--", *patterns]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except OSError:
        return []
    if r.returncode != 0:
        return []
    return [line for line in r.stdout.splitlines() if line.strip()]


def round_summary(r):
    return {k: r.get(k) for k in ("round", "date", "fail", "new", "fixed",
                                  "unfixed", "escalated")}


def md_cell(value):
    return str(value).replace("|", "\\|").replace("\n", "; ")


def review_report(gate, spec, checks, violations, rounds, delta, escalated,
                  changed=(), changed_rev=None, delta_lists=()):
    lines = [f"# Review: {gate} — {spec}", ""]
    lines.append(f"- **Date**: {date.today().isoformat()}")
    lines.append(f"- **Spec**: `{spec}`")
    lines.append(f"- **Verdict**: "
                 f"{'pass' if not violations else 'reject'} (derived)")
    if delta:
        lines.append(f"- **Since last run**: {delta['since']}, "
                     f"{delta['violations']} violations then")
    if changed_rev:
        lines.append(f"- **Changed since** `{changed_rev[:8]}`: "
                     f"{', '.join(changed) or 'no files in touches'}")
    lines += ["", "## Rounds", "",
              "| round | date | fail | new | fixed | unfixed | escalated |",
              "|---|---|---|---|---|---|---|"]
    for r in rounds:
        lines.append(f"| {r.get('round')} | {r.get('date')} "
                     f"| {r.get('fail', 0)} | {r.get('new', 0)} "
                     f"| {r.get('fixed', 0)} | {r.get('unfixed', 0)} "
                     f"| {r.get('escalated', 0)} |")
    if delta_lists:
        lines += ["", "## Delta", ""]
        for label, items in delta_lists:
            shown = ", ".join(f"`{v.get('rule')}` at `{v.get('path')}`"
                              for v in items[:5])
            more = f" (+{len(items) - 5} more)" if len(items) > 5 else ""
            lines.append(f"- **{label}**: {len(items)}"
                         + (f" — {shown}{more}" if items else ""))
    lines += ["", "## Checks", "", "| rule | status | detail |",
              "|---|---|---|"]
    for c in checks:
        lines.append(f"| {md_cell(c['rule'])} | {c['status']} "
                     f"| {md_cell(c['detail'])} |")
    lines += ["", "## Violations", "", "| rule | path | detail |",
              "|---|---|---|"]
    if violations:
        for v in violations:
            lines.append(f"| {md_cell(v['rule'])} | {md_cell(v['path'])} "
                         f"| {md_cell(v['detail'])} |")
    else:
        lines.append("| (none) | | |")
    if escalated:
        lines += ["", "## Escalate to human", ""]
        for v in escalated:
            lines.append(f"- `{v['rule']}` at `{v['path']}`: unfixed for two "
                         "consecutive rounds; the next loop is the human's.")
    return "\n".join(lines) + "\n"


def cmd_review(a):
    root = find_root(a.root)
    check_slug(a.spec)
    sdir = root / ESDD_DIR / "specs" / a.spec
    if not sdir.is_dir():
        die(f"no spec directory at {sdir}", 2)
    patterns = []
    if a.gate == "tickets":
        checks, violations = review_tickets(root, a.spec, sdir)
    elif a.gate == "design":
        checks, violations = review_design(root, a.spec, sdir)
    else:
        if not a.task:
            die("--task <uuid> is required for --gate code", 2)
        checks, violations, patterns, err = review_code(
            root, a.spec, sdir, a.task, a.run_verify)
        if err:
            die(err, 2)

    state = read_state(root)
    prev = (state.get("gates") or {}).get(a.gate)
    if prev and prev.get("spec") not in (None, a.spec):
        prev = None  # violation identity is per spec
    prev_round = (prev.get("rounds") or [None])[-1] if prev else None
    prev_ids = {(v.get("rule"), v.get("path"))
                for v in (prev_round or {}).get("violations", [])}
    cur_ids = {(v["rule"], v["path"]) for v in violations}
    new = [v for v in violations if (v["rule"], v["path"]) not in prev_ids]
    unfixed = [v for v in violations if (v["rule"], v["path"]) in prev_ids]
    fixed = [v for v in (prev_round or {}).get("violations", [])
             if (v.get("rule"), v.get("path")) not in cur_ids]

    history = list(prev.get("rounds", [])) if prev else []
    round_no = ((history[-1].get("round") or len(history)) + 1
                if history else 1)
    cur_round = {"round": round_no, "date": date.today().isoformat(),
                 "fail": len(violations), "new": len(new),
                 "fixed": len(fixed), "unfixed": len(unfixed),
                 "escalated": 0,
                 "violations": [{"rule": v["rule"], "path": v["path"]}
                                for v in violations]}
    history.append(cur_round)
    escalated = []
    for v in violations:
        streak = 0
        for r in reversed(history):
            if any(x.get("rule") == v["rule"] and x.get("path") == v["path"]
                   for x in r.get("violations", [])):
                streak += 1
            else:
                break
        v["escalate"] = streak >= 2
        if v["escalate"]:
            escalated.append(v)
    cur_round["escalated"] = len(escalated)
    rounds = history[-10:]

    delta = None
    changed, changed_rev = [], None
    if prev_round:
        delta = {"since": prev.get("last_run"),
                 "violations": prev.get("violations", 0),
                 "new": len(new), "fixed": len(fixed),
                 "unfixed": len(unfixed),
                 "new_items": [{"rule": v["rule"], "path": v["path"]}
                               for v in new],
                 "fixed_items": [{"rule": v.get("rule"),
                                  "path": v.get("path")} for v in fixed],
                 "unfixed_items": [{"rule": v["rule"], "path": v["path"]}
                                   for v in unfixed]}
        if a.gate == "code" and prev.get("git_rev"):
            changed_rev = prev["git_rev"]
            changed = git_changed_since(root, changed_rev, patterns)

    state.setdefault("gates", {})[a.gate] = {
        "spec": a.spec,
        "last_run": date.today().isoformat(),
        "git_rev": git_head(root),
        "violations": len(violations),
        "rounds": rounds,
    }
    write_state(root, state)

    report_path = (Path(a.out).expanduser() if a.out
                   else sdir / f"review-{a.gate}.md")
    report_path.parent.mkdir(parents=True, exist_ok=True)
    report_path.write_text(review_report(
        a.gate, a.spec, checks, violations, rounds, delta, escalated,
        changed, changed_rev,
        [("new", new), ("fixed", fixed), ("unfixed", unfixed)]
        if prev_round else ()))

    if a.json:
        payload = {"gate": a.gate, "spec": a.spec,
                   "pass": not violations, "violations": violations,
                   "checks": checks,
                   "rounds": [round_summary(r) for r in rounds]}
        if delta:
            payload["delta"] = delta
        if changed_rev:
            payload["changed_since"] = {"rev": changed_rev, "files": changed}
        out(json.dumps(payload))
    else:
        out(f"review {a.gate} — {a.spec}: "
            f"{'PASS' if not violations else 'FAIL'}")
        if delta:
            out(f"since last run: {delta['since']}, "
                f"{delta['violations']} violations then")
        if changed_rev:
            out(f"changed since {changed_rev[:8]}: "
                f"{', '.join(changed) or 'no files in touches'}")
        for c in checks:
            if c["status"] != "pass":
                out(f"  {c['status'].upper():8} {c['rule']}: {c['detail']}")
        for v in violations:
            flag = "  [ESCALATE]" if v.get("escalate") else ""
            out(f"  FAIL     {v['rule']} {v['path']}: {v['detail']}{flag}")
        if escalated:
            out("escalate to human: " + ", ".join(
                f"{v['rule']} at {v['path']}" for v in escalated))
        out(f"report: {report_path}")
    sys.exit(1 if violations else 0)


# ------------------------------------------------------------------- graph ---

def graph_root(root, source=None):
    base = root / ESDD_DIR / "graph"
    return base / source if source else base


def read_manifest(gdir):
    p = gdir / "manifest.json"
    if not p.is_file():
        return None
    try:
        return json.loads(p.read_text())
    except json.JSONDecodeError:
        warn(f"corrupt manifest in {gdir}")
        return None


def snapshot_stats(path):
    """Lightweight check of a normalized snapshot.json: element/edge counts."""
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as e:
        raise SystemExit(1)
    if not isinstance(data, dict):
        raise SystemExit(1)
    nodes = data.get("elements")
    edges = data.get("edges")
    if not isinstance(nodes, list) or not all(isinstance(n, dict) for n in nodes):
        raise SystemExit(1)
    if edges is not None and (not isinstance(edges, list)
                              or not all(isinstance(e, dict) for e in edges)):
        raise SystemExit(1)
    return len(nodes), len(edges or [])


def cmd_import(a):
    """Cache a graph/navigation source's output under .esdd/graph/<source>."""
    root = find_root(a.root)
    if not a.source and not a.list_sources:
        die("pass --source <name> (codegraph, graphify, falkordb, neo4j, "
            "understand, groma, custom, ...) or use --list-sources")
    if a.list_sources:
        gbase = graph_root(root)
        if not gbase.is_dir():
            out("no graph sources cached (import one with: esdd import "
                "--source <name> --path <file-or-dir>)")
            return
        for d in sorted(gbase.iterdir()):
            if not d.is_dir():
                continue
            man = read_manifest(d) or {}
            snap = d / "snapshot.json"
            size = sum(f.stat().st_size for f in d.rglob("*") if f.is_file())
            line = f"{d.name:<14} {size/1024:>8.0f} KiB  imported {man.get('imported', '?')}"
            if snap.is_file():
                try:
                    n, e = snapshot_stats(snap)
                    line += f"  [{n} elements, {e} edges]"
                except SystemExit:
                    line += "  [snapshot.json invalid]"
            out(line)
        return

    check_slug(a.source, "source name")
    gdir = graph_root(root, a.source)
    gdir.mkdir(parents=True, exist_ok=True)
    copied = []
    snap_name = None
    if a.path:
        src = Path(a.path).expanduser().resolve()
        if not src.exists():
            die(f"path not found: {src}")
        if src.is_file():
            dest_name = "snapshot.json" if a.snapshot else src.name
            dest = gdir / dest_name
            shutil.copy2(src, dest)
            copied = [dest.name]
            if a.snapshot:
                snap_name = "snapshot.json"
        else:
            for f in sorted(src.rglob("*")):
                if f.is_file():
                    rel = f.relative_to(src)
                    dest = gdir / rel
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(f, dest)
                    copied.append(str(rel))
                    if dest.stat().st_size > a.max_file_mb * 1_000_000:
                        warn(f"{dest.name} is large "
                             f"({dest.stat().st_size // 1000} KiB); "
                             "consider summarizing it into snapshot.json before "
                             "any agent reads it (token budget applies to graphs)")
        a.path = str(src)

    man = {
        "source": a.source,
        "imported": date.today().isoformat(),
        "origin_path": a.path,
        "files": copied,
        "snapshot": snap_name or ("snapshot.json"
                                  if (gdir / "snapshot.json").is_file() else None),
        "notes": a.notes or "",
    }
    (gdir / "manifest.json").write_text(json.dumps(man, indent=2) + "\n")
    snap = gdir / "snapshot.json"
    if snap.is_file():
        try:
            n, e = snapshot_stats(snap)
            out(f"imported source '{a.source}': snapshot.json ok "
                f"({n} elements, {e} edges)")
        except SystemExit:
            out(f"imported source '{a.source}': WARNING snapshot.json is not a "
                "valid normalized snapshot (see references/retro.md)")
    else:
        out(f"imported source '{a.source}': {len(copied)} file(s) cached")
        if copied:
            out("NOTE no snapshot.json in cache - normalize one before running "
                "esdd phase retro (schema in references/retro.md), or re-import "
                "the file with --snapshot")
    out(f"cache: {gdir}")


# ------------------------------------------------------------------- phase ---

def cmd_phase(a):
    root = find_root(a.root)
    state = read_state(root)
    if not a.name:
        out(f"current phase: {state.get('current_phase') or '-'}")
        out(f"active spec:   {state.get('spec') or '-'}")
        out(f"completed:     {', '.join(state.get('completed', [])) or '-'}")
        out("phases: " + ", ".join(PHASES))
        return
    if a.name not in PHASES:
        die(f"unknown phase '{a.name}' (choose: {', '.join(PHASES)})")
    if not PHASES[a.name].get("spec", True):
        slug = None  # workspace-level phase: never inherits an active spec
    else:
        slug = a.spec or state.get("spec")
        if not slug:
            die("spec required: esdd phase <name> --spec <slug>")
    missing = [r.format(s=slug) for r in PHASES[a.name]["requires"]]
    missing = [m for m in missing if not (root / ESDD_DIR / m).exists()]
    if missing and a.strict:
        die(f"phase '{a.name}' is missing prerequisites: {', '.join(missing)}", 2)
    if missing:
        warn(f"phase '{a.name}' is missing prerequisites: {', '.join(missing)}")
    if a.done:
        done = state.setdefault("completed", [])
        if a.name not in done:
            done.append(a.name)
    state["current_phase"] = a.name
    if slug:
        state["spec"] = slug
    write_state(root, state)
    out(f"phase '{a.name}' active"
        + (f" for spec '{slug}'" if slug else " (workspace level)")
        + (" (marked done)" if a.done else ""))
    skill_dir = SCRIPT_DIR.parent
    for ref in PHASES[a.name]["refs"]:
        out(f"  read: {skill_dir / ref}")
    if missing:
        out("  prerequisites missing - resolve them before proceeding")


# -------------------------------------------------------------------- main ---

def main():
    p = argparse.ArgumentParser(prog="esdd", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--root", help="workspace root containing .esdd "
                                  "(default: nearest parent with .esdd)")
    sub = p.add_subparsers(dest="cmd", required=True)

    pi = sub.add_parser("init", help="scaffold .esdd/ here")
    pi.add_argument("--graph-nav", choices=GRAPH_NAV_CHOICES,
                    help="write this choice into .esdd/env immediately")
    pi.set_defaults(fn=cmd_init)

    pd = sub.add_parser("doctor", help="check installation and workspace")
    pd.set_defaults(fn=cmd_doctor)

    pe = sub.add_parser("env", help="read/write .esdd/env")
    pe.add_argument("key", nargs="?")
    pe.add_argument("value", nargs="?")
    pe.add_argument("extra", nargs="?", help=argparse.SUPPRESS)
    pe.add_argument("--unset")
    pe.set_defaults(fn=cmd_env)

    ptw = sub.add_parser("tw", help="run task(1) against nearest .esdd/tasks")
    ptw.add_argument("--batch", action="store_true",
                     help="disable confirmation prompts (scripts)")
    ptw.add_argument("args", nargs=argparse.REMAINDER)
    ptw.set_defaults(fn=cmd_tw)

    ppo = sub.add_parser("po", help="Product Owner entry points")
    pposub = ppo.add_subparsers(dest="pocmd", required=True)
    ppoi = pposub.add_parser("import", help="copy an external spec/plan into "
                             ".esdd/specs/<slug>/sources/ for PO import mode")
    ppoi.add_argument("file", help="Jira export, Taskmaster tasks.json, plan.md, ...")
    ppoi.add_argument("--spec", required=True, help="target spec slug")
    ppoi.add_argument("--project", default="core",
                      help="middle project segment (default: core)")
    ppoi.add_argument("--title", help="human-readable title")
    ppoi.set_defaults(fn=cmd_po_import)

    ps = sub.add_parser("spec", help="manage specs")
    sp = ps.add_subparsers(dest="scmd", required=True)
    psn = sp.add_parser("new", help="scaffold .esdd/specs/<slug>/ + index task")
    psn.add_argument("slug")
    psn.add_argument("--project", default="core",
                     help="middle project segment (default: core)")
    psn.add_argument("--title", help="human-readable title")
    psn.add_argument("--no-index", action="store_true",
                     help="skip creating the Taskwarrior index task")
    psn.add_argument("--force", action="store_true")
    psn.set_defaults(fn=cmd_spec_new)
    psl = sp.add_parser("list", help="list specs and artifact status")
    psl.add_argument("--json", action="store_true", help="machine-readable output")
    psl.set_defaults(fn=cmd_spec_list)

    pa = sub.add_parser("adr", help="manage MADR ADRs (3 levels)")
    ap = pa.add_subparsers(dest="acmd", required=True)
    pan = ap.add_parser("new")
    pan.add_argument("--level", required=True,
                     choices=["global", "directory", "spec"])
    pan.add_argument("--title", required=True)
    pan.add_argument("--spec", help="spec slug (required for --level spec)")
    pan.set_defaults(fn=cmd_adr_new)
    pal = ap.add_parser("list")
    pal.add_argument("--level", choices=["global", "directory", "spec"])
    pal.add_argument("--spec")
    pal.set_defaults(fn=cmd_adr_list)

    pm = sub.add_parser("matrix", help="blocking-edge matrix from task export")
    pm.add_argument("--spec")
    pm.add_argument("--out", help="write markdown to this file")
    pm.add_argument("--json", action="store_true", help="machine-readable output")
    pm.set_defaults(fn=cmd_matrix)

    pe2 = sub.add_parser("estimate", help="token estimates from touches UDA")
    pe2.add_argument("--spec")
    pe2.add_argument("--all", action="store_true",
                     help="also list tasks without touches")
    pe2.add_argument("--set", action="store_true",
                     help="write token_estimate back to tasks")
    pe2.add_argument("--touches",
                     help="estimate these comma-separated globs directly "
                          "(no Taskwarrior needed; tasks.md fallback)")
    pe2.add_argument("--json", action="store_true", help="machine-readable output")
    pe2.set_defaults(fn=cmd_estimate)

    pv = sub.add_parser("verify", help="handoff gate for a spec")
    pv.add_argument("--spec", required=True)
    pv.add_argument("--json", action="store_true", help="machine-readable output")
    pv.set_defaults(fn=cmd_verify)

    prv = sub.add_parser("review", help="deterministic review gates "
                                       "(design/tickets/code)")
    prv.add_argument("--gate", required=True, choices=REVIEW_GATES)
    prv.add_argument("--spec", required=True)
    prv.add_argument("--task", help="task uuid/prefix (required for --gate code)")
    prv.add_argument("--json", action="store_true", help="machine-readable output")
    prv.add_argument("--out", help="write the markdown report here "
                                   "(default: spec dir review-<gate>.md)")
    prv.add_argument("--run-verify", action="store_true",
                     help="code gate: execute the brief's Verify command "
                          "(default: off)")
    prv.set_defaults(fn=cmd_review)

    pg = sub.add_parser("import", help="cache a graph/nav source into .esdd/graph/")
    pg.add_argument("--source", help="e.g. codegraph, graphify, falkordb, neo4j, "
                                    "understand, groma, custom")
    pg.add_argument("--path", help="file or directory to copy into the cache")
    pg.add_argument("--notes", help="free-text annotation stored in the manifest")
    pg.add_argument("--max-file-mb", type=float, default=10,
                    help="warn above this many MB per cached file (default 10)")
    pg.add_argument("--snapshot", action="store_true",
                    help="register a single-file --path as this source's "
                         "normalized snapshot.json")
    pg.add_argument("--list-sources", action="store_true",
                    help="list cached graph sources and exit")
    pg.set_defaults(fn=cmd_import)

    pp = sub.add_parser("phase", help="track workflow phases")
    pp.add_argument("name", nargs="?", choices=list(PHASES))
    pp.add_argument("--spec")
    pp.add_argument("--done", action="store_true", help="mark phase completed")
    pp.add_argument("--strict", action="store_true",
                    help="exit 2 without changing state if prerequisites are missing")
    pp.set_defaults(fn=cmd_phase)

    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
